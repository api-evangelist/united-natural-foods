            "params": [
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Start date for insights query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "End date for insights query"
              },
              {
                "name": "granularity",
                "value": "",
                "type": "query",
                "description": "Data aggregation granularity"
              },
              {
                "name": "region",
                "value": "",
                "type": "query",
                "description": "Distribution region filter"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
