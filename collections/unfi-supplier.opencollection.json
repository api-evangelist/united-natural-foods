                "name": "warehouseId",
                "value": "",
                "type": "query",
                "description": "Filter by specific UNFI warehouse"
              },
              {
                "name": "asOf",
                "value": "",
                "type": "query",
                "description": "Inventory snapshot date"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve inventory levels, voids, and food waste dashboard data."
        }
      ]
    },
    {
