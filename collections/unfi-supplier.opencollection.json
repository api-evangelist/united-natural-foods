          "http": {
            "method": "GET",
            "url": "https://api.unfi.com/v1/insights/fill-rates",
            "params": [
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "productId",
                "value": "",
                "type": "query",
                "description": "Filter by specific product"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve fill rate metrics for supplier products across UNFI distribution centers."
        },
        {
          "info": {
            "name": "Get Inventory Insights",
            "type": "http"
